# Beispiel-Umgebung fuer fox_netmap (alle NETZ_*-Variablen aus app/settings_schema.py).
# Werte hier eintragen oder als echte Umgebungsvariablen setzen; Compose reicht sie an beide Dienste durch.
# Secrets (NETZ_AUTH_PASS, NETZ_FRITZ_PASS, NETZ_NOTIFY_*_TOKEN, NETZ_SNMP_COMMUNITY, NETZ_DOCKER_TOKEN, NETZ_PVE_TOKEN_SECRET) nie committen!
NETZ_DATA_DIR=./data
NETZ_SQLITE_JOURNAL=auto

NETZ_ALARM_WHITELIST=
NETZ_AUTH_ENABLED=true
NETZ_AUTH_PASS=
NETZ_AUTH_USER=admin
NETZ_AUTO_EXPORT=false
NETZ_AUTO_EXPORT_DIR=exports
NETZ_AUTO_EXPORT_INTERVAL_HOURS=24
NETZ_COOKIE_SECURE=auto
NETZ_DATA_DIR=
NETZ_DEVICE_RETENTION_DAYS=30
NETZ_EMBED_ANCESTORS=*
NETZ_EVENT_RETENTION_DAYS=90
NETZ_FRITZ_MESH=true
NETZ_FRITZ_PASS=
NETZ_FRITZ_URL=
NETZ_FRITZ_URLS=
NETZ_FRITZ_USER=
NETZ_HISTORY_HOURS=720
NETZ_HOST=
NETZ_LANG=de
NETZ_MDNS_ENABLED=true
NETZ_NOTIFY_GOTIFY=
NETZ_NOTIFY_GOTIFY_TOKEN=
NETZ_NOTIFY_NTFY=
NETZ_NOTIFY_NTFY_TOKEN=
NETZ_NOTIFY_WEBHOOK=
NETZ_OUI_ONLINE_ENABLED=false
NETZ_OUI_ONLINE_MAX=10
NETZ_OUI_ONLINE_URL=https://api.macvendors.com
NETZ_PORT=
NETZ_PORT_TOP=1000
NETZ_PORTS=
NETZ_SCAN_INTERVAL=900
NETZ_SCAN_TIMEOUT=1
NETZ_SITES=
NETZ_SNMP_COMMUNITY=
NETZ_SNMP_ENABLED=true
NETZ_SNMP_SWITCHES=

# Containerlandschaft-Scan ueber die Docker Engine API (read-only, default AUS - API ist root-aequivalent am Host)
NETZ_DOCKER_ENABLED=false
NETZ_DOCKER_HOSTS=
NETZ_DOCKER_INSECURE_TLS=false
NETZ_DOCKER_TOKEN=

# Proxmox VE API (read-only GETs, Token-Auth statt Passwort, default AUS - API-Token kann admin-aequivalent sein, E-9)
NETZ_PVE_ENABLED=false
NETZ_PVE_URLS=
NETZ_PVE_USER=
NETZ_PVE_TOKEN_ID=
NETZ_PVE_TOKEN_SECRET=
NETZ_PVE_INSECURE_TLS=false
NETZ_SUBNET=
NETZ_SUBNETS=
NETZ_THEME=dark
NETZ_TR064_INSECURE_TLS=false
NETZ_VPN_POOL=off
